# Copy this file to .env (same folder) and fill it in. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB connection string. Use MongoDB Atlas (see README → "Getting a MongoDB URL"), e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/restaurant_billing?retryWrites=true&w=majority
# For local development without installing MongoDB you can use: MONGODB_URI=memory
# (starts a local single-node replica set, data kept in server/.data – development only).
MONGODB_URI=

# Long random secret used to sign sessions (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long a sign-in lasts
SESSION_TTL_HOURS=12

# Browser origins allowed to call the API (comma separated). The Vite dev server by default.
CORS_ORIGINS=http://localhost:5173

# Time zone used for "today", date filters and daily/monthly reports
APP_TIMEZONE=Asia/Kolkata

# Set to true when served over HTTPS (production). Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# Single-server deployment: let Express serve the built React app from client/dist
SERVE_CLIENT=false

# Number of reverse proxies in front of the app (for correct client IPs in rate limiting).
# TRUST_PROXY=1   (automatic on Vercel; set it when running behind your own reverse proxy)

# Failed sign-in attempts allowed per IP per 15 minutes
LOGIN_RATE_LIMIT_MAX=10

# Where menu photos are kept: mongo (in the database – required on Vercel) or local (UPLOAD_DIR)
IMAGE_STORAGE=mongo
# Folder for IMAGE_STORAGE=local (defaults to server/uploads)
# UPLOAD_DIR=

# Used only by `npm run setup:superadmin` (optional – it prompts otherwise)
# SUPERADMIN_NAME=
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=
